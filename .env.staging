# 页面标题
VITE_APP_TITLE = 江苏民诺集团

# 生产环境配置
VITE_APP_ENV = 'staging'

# 民诺官网后台管理系统/生产环境
VITE_APP_BASE_API = https://mnerp.minnuo.group/api/

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# 图片路径
VITE_BASE_IMG_URL= https://minnuo-test.oss-cn-qingdao.aliyuncs.com/

# WebSocket 服务器地址
VITE_WS_URL=http://localhost:8080/ws

# 是否启用 WebSocket（可选，默认 true）
VITE_ENABLE_WEBSOCKET=false